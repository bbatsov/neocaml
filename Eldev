; -*- mode: emacs-lisp; lexical-binding: t -*-

(eldev-require-version "1.11")

(eldev-use-package-archive 'gnu-elpa)
(eldev-use-package-archive 'nongnu-elpa)
(eldev-use-package-archive 'melpa)

(eldev-use-plugin 'autoloads)

;; ocaml-eglot and merlin are only needed to check that our keys don't
;; clash with theirs.
(eldev-add-extra-dependencies 'test 'buttercup 'ocaml-eglot 'merlin)
(eldev-add-loading-roots 'test "test")

;; configuration for the default linters
(setq byte-compile-docstring-max-column 120)
(setq checkdoc-force-docstrings-flag nil)
(setq checkdoc-permit-comma-termination-flag t)
(setq checkdoc--interactive-docstring-flag nil)

;; package-lint warns about every `with-eval-after-load', but neocaml.el
;; uses it on purpose, to register its modes with eglot and dape
;; whenever those load.
(with-eval-after-load 'package-lint
  (advice-add 'package-lint--check-eval-after-load :around
              (lambda (check)
                (unless (equal (file-name-nondirectory (or buffer-file-name ""))
                               "neocaml.el")
                  (funcall check)))))

(setq eldev-project-main-file "neocaml.el")

;; dev/ holds scripts for working on neocaml, not part of the package
(setf eldev-standard-excludes `(:or ,eldev-standard-excludes "./dev"))
